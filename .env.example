# ============ 对外地址（生产必填）============
# OG/Twitter 卡片、分享页绝对链接都基于它（app/layout.tsx 的 metadataBase）：
# 不填会退回 http://localhost:3000，生产分享出去的海报/卡片全指本机（P0-6）。
# 上线前换成真实 https 域名（preflight 对缺失/非 https 一律 BLOCK）。
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ============ LLM（生成行程）============
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_API_KEY=在这里填你的key
LLM_MODEL=step-5-preview
# step-5 是推理模型：effort 决定推理预算。medium 容易把正文挤没且慢一倍，行程任务用 low 足够
LLM_REASONING_EFFORT=low
# 推理 token + 正文共用这个额度，行程 JSON 很长，必须给够
LLM_MAX_TOKENS=64000
# 单次流式调用的总时长上限（毫秒，默认 10 分钟）：SDK timeout 只管 chunk 间隔，
# 上游挂住不发 chunk 时任务会变成永远 running 的僵尸——用这个兜底中止。
# LLM_STREAM_DEADLINE_MS=600000

# ============ 高德 Web 服务 API（POI 验真 + 通勤矩阵）============
# 不填则自动进入 MOCK 模式：全链路可跑，POI 不验真（仅用于开发调试）
# 申请：https://console.amap.com/dev/key/app （个人版免费，选"Web服务"类型）
AMAP_WEB_SERVICE_KEY=
# 默认 https://restapi.amap.com；测试时可指向本地桩服务
AMAP_BASE_URL=
# 真实地图（每日路线的静态地图底图）复用上面同一个 key。
# 个人 key 的静态地图有独立日配额，本地调试/截图时可用它临时关掉：
# AMAP_MAP_DISABLED=1

# ============ 每日免费次数（防薅，v0 按 IP 维度）============
DAILY_FREE_LIMIT=3

# ============ 存储（生产必填）============
# memory=进程内存（开发默认）：重启丢 Plan（分享链接 404）、配额归零、多副本各算各的
# postgres=PostgreSQL（生产必须；建表走 npm run db:migrate，迁移历史在 prisma/migrations/）
# 注意：preflight 对「缺失 / memory」在生产一律 BLOCK——分享链接长期有效是产品承诺。
DATA_STORE=memory
# DATA_STORE=postgres 时必填。Prisma 7 + @prisma/adapter-pg 只认 postgres:// 连接串：
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/travel_planner

# ============ 行程修改（换一个 / 一句话改一天 / 一键修复）============
# 每小时每 IP 的修改次数上限（修改会调 LLM，但不占用每日生成配额）
REFINE_HOURLY_LIMIT=20
# 「攻略粘贴 → 条件提取」（/api/plan/extract，不占生成配额但调一次 LLM）的小时限流
# EXTRACT_HOURLY_LIMIT=10

# SEO：sitemap.xml / robots.txt 里的站点根地址（不配则用演示站默认值）
# NEXT_PUBLIC_SITE_URL=https://travel-planner-demo.onrender.com
# 「一键顺延时间轴」等确定性重排（不调 LLM，成本极低）的独立小时桶
# ADJUST_HOURLY_LIMIT=60
# 「行中重规划求解器」（确定性、不调模型、不落库，与 adjust 同级）的小时桶，默认 60
# REPLAN_HOURLY_LIMIT=60
# 「行程管家」对话（step-5，按次计费）的小时限流
# COPILOT_HOURLY_LIMIT=40

# ============ 任务心跳自愈 ============
# 超过这么久没有进度心跳的 running 任务判定为中断（服务重启/进程被杀），
# 前端会立刻收到 error 而不是白轮询到 15 分钟。默认 12 分钟（正常生成 2-8 分钟会持续心跳）
# JOB_STALE_MS=720000

# ============ 全局限流 / 成本闸门（配额按 IP 可伪造，这里是服务端兜底）============
# 前面有几层「受信反代」。XFF 链从右往左数第 N 个才是真实客户端；默认 1
# （假设前面有一层 nginx/云托管，且它追加真实 IP）。直连公网必须设 0：
# 此时无法拿到可信 IP，所有请求共享 "direct" 桶 = 配额退化为全局限额，
# 所以生产部署必须接一层反代（见 DEPLOY.md 的 Runbook）。
# TRUSTED_PROXY_HOPS=1
# 同时在跑的生成任务上限（进程内；多实例部署时是「每实例上限」）
# MAX_CONCURRENT_GENERATIONS=6
# 同时在跑的 LLM 调用上限（生成 + 改行程 + 行程管家，每实例）
# MAX_CONCURRENT_LLM=12
# 每日全站最多生成多少次（每实例，UTC 日；防伪造 IP / 真实爆量把账单拉满的最后一道闸）
# DAILY_GLOBAL_LIMIT=500
# 每日全站 LLM 调用次数上限（生成之外含「改行程/行程管家」；公开演示站防刷）
# DAILY_GLOBAL_LLM_LIMIT=300
# 只读高德代理端点的按 IP 小时限流（防公开站被刷爆 key 配额 / 堵死地图队列）
# MAP_HOURLY_LIMIT=600
# PLACES_HOURLY_LIMIT=600
# GEOCODE_HOURLY_LIMIT=120
# WEATHER_HOURLY_LIMIT=120
# Trip Check 公开核验 API 的按 IP 小时上限（POST /api/verify；判定是纯函数、不调上游，
# 限流只为防刷与公平使用；默认 120）
# VERIFY_HOURLY_LIMIT=120

# ============ 登录体系（可选增强）============
# none=开发模式（验证码固定 123456，不发短信）；sms=短信；wechat=OAuth 跳转
# ⚠️ 生产禁止 none：默认配置下任意手机号都能用固定验证码登录，且退出登录
#    后 session 可被伪造（见 SESSION_SECRET）。生产配 sms/wechat；
#    确需在预发/内部演示用 none 时，必须同时显式设 ALLOW_DEV_AUTH=1（并在
#    SESSION_SECRET 填强随机值），否则运行时守卫会整体关闭登录、preflight 也会 BLOCK。
AUTH_PROVIDER=none
# 生产显式允许 none/dev provider 的逃生开关（仅预发/内部演示，不要对公网开）：
# ALLOW_DEV_AUTH=1
# session cookie 的 HMAC 密钥。⚠️ 生产禁止用这个开发默认值：它是源码里的公开
# 常量，等于没有签名——任何人都能签出任意手机号的 session。生产必须换成随机长
# 字符串（openssl rand -hex 32）；缺失或仍是默认值时，生产环境会拒绝签发/校验
# session 并打一条 error 日志，preflight 也会 BLOCK。
SESSION_SECRET=dev-only-insecure-secret
# 登录用户的每日次数（未登录按上面的 DAILY_FREE_LIMIT）
AUTH_USER_LIMIT=10
# ---- sms provider 预留（AUTH_PROVIDER=sms 时必填，腾讯云）----
# SMS_SECRET_ID=云 API 密钥 SecretId（控制台 → 访问管理 → API 密钥管理）
# SMS_SECRET_KEY=云 API 密钥 SecretKey
# SMS_APP_ID=短信应用 ID（SdkAppId）
# SMS_SIGN=短信签名（需审核通过）
# SMS_TEMPLATE_ID=验证码模板 ID（模板内容：您的验证码是 {1}，5 分钟内有效）
# SMS_REGION=ap-guangzhou
# SMS_API_BASE=https://sms.tencentcloudapi.com   # 测试时可指向本地桩
# 防轰炸：单手机号 5 条/小时，单 IP 20 条/小时（可调）
# SMS_PHONE_LIMIT=5
# SMS_IP_LIMIT=20
# ---- wechat provider 预留（AUTH_PROVIDER=wechat 时必填）----
# WECHAT_APPID=你的公众号/开放平台 AppID
# WECHAT_SECRET=AppSecret
# WECHAT_API_BASE=https://api.weixin.qq.com      # 测试时可指向本地桩
# WECHAT_AUTH_BASE=https://open.weixin.qq.com   # 测试时可指向本地桩

# ============ 产品指标看板 ============
# GET /api/events/summary?token=<METRICS_TOKEN> 的访问令牌。
# 不配置 = 看板一律 404（不暴露“这里有个看板”）。用 openssl rand -hex 24 生成。
# METRICS_TOKEN=
# 埋点上报限流（每 IP 每小时条数，默认 300）
# EVENT_HOURLY_LIMIT=300
