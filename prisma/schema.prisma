generator client {
  provider = "prisma-client-js"
}

// Prisma 7 起 schema 不再携带连接串：CLI（migrate/db push）的连接地址移到
// prisma.config.ts，运行时的直连则通过 PrismaClient 构造参数传 driver adapter
// （见 lib/store/postgres.ts）。详见 https://pris.ly/d/config-datasource
datasource db {
  provider = "postgresql"
}

/// 行程生成任务（原内存 Map，重启即丢 → 持久化）
model Job {
  id        String   @id
  status    String // running | done | error
  plan      Json?
  error     String?
  key       String // 配额键（u:<phone> / ip:<addr>）
  limit     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 每日配额计数（按 key + 日期）
model QuotaBucket {
  key   String @id
  date  String
  count Int
}

/// 短信验证码（5 分钟有效、一次性）
model SmsCode {
  phone     String   @id
  code      String
  expiresAt DateTime
}
