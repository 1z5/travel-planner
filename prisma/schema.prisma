generator client {
  provider = "prisma-client-js"
}

// Prisma 7 起 schema 不再携带连接串：CLI（migrate/db push）的连接地址移到
// prisma.config.ts，运行时的直连则通过 PrismaClient 构造参数传 driver adapter
// （见 lib/store/postgres.ts）。详见 https://pris.ly/d/config-datasource
datasource db {
  provider = "postgresql"
}

/// 行程生成任务（原内存 Map，重启即丢 → 持久化）
model Job {
  id        String   @id
  status    String // running | done | error
  plan      Json?
  error     String?
  key       String // 配额键（u:<phone> / ip:<addr>）
  limit     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // 心跳：陈旧 running 任务自愈靠它（见 app/api/plan/status）
  shareId   String? // 生成完成后指向 Plan.id（分享 token）；缺省 = 无分享链接
}

/// 行程（一等聚合，id 即分享 token）。
///
/// 为什么从 Job 里拆出来：Job 是一次性执行记录（TTL 2 小时），而分享链接 /
/// 改行程 / 最近行程都要求行程比生成过程活得久。ownerKey 为「最近行程」预留，
/// revision 让「改行程」有并发语义（每次替换 +1）。
///
/// 【部署注意】新增本表后必须对数据库执行一次结构同步，否则
/// DATA_STORE=postgres 下生成完成写 Plan 会报表不存在：
///   npx prisma db push        # 开发/单实例快速同步
///   # 或 npx prisma migrate deploy（使用已提交 migration 的正规路径）
/// memory 实现无需任何操作（默认 DATA_STORE=memory）。
model Plan {
  id        String   @id
  jobId     String?
  ownerKey  String?
  plan      Json
  input     Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 每日配额计数（按 key + 日期）
model QuotaBucket {
  key   String @id
  date  String
  count Int
}

/// 短信验证码（5 分钟有效、一次性）
model SmsCode {
  phone     String   @id
  code      String
  expiresAt DateTime
}

/// 产品事件（度量闭环的最小实现）。
///
/// 为什么需要：北极星指标「照着走完的比例」（出行期间未手动改过当天安排的行程占比）
/// 此前**无法计算**——stage 遥测只在进程内存里，多实例即丢，也没有任何事件落库。
/// 没有这个指标，产品迭代只能靠个别用户反馈猜。
///
/// 记录口径（诚实优先）：
/// - 只记「行为」，不记内容：shareId（用户本就持有的 token）+ 城市 + 第几天 +
///   少量布尔/枚举 meta。不存手机号、不存 POI 文本、不存 IP（IP 只用于限流，
///   由 ratelimit 的 hourKey 承担，不进入本表）。
/// - 事件名是封闭枚举（见 lib/metrics.ts 的 EVENT_NAMES），避免脏数据把看板搞糊。
model TripEvent {
  id        String   @id
  name      String // 事件名（EVENT_NAMES 之一）
  shareId   String? // 关联行程（分享 token；未登录/无行程的事件为 null）
  city      String? // 目的地（冗余存储，看板按城市汇总时不用 join Plan）
  day       Int? // 行程第几天（行中/修改类事件用）
  meta      Json? // 少量结构化补充（如 { changed: true } / { op: "reorder" }）
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([shareId])
  @@index([createdAt])
}
