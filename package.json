{
  "name": "travel-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.23.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "verify:amap": "node --env-file=.env scripts/verify-amap.mjs",
    "eval:cases": "node scripts/eval-cases.mjs",
    "smoke": "node scripts/smoke-deployed.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "framer-motion": "^14.2.0",
    "lucide-react": "^1.56.0",
    "next": "^15.5.0",
    "openai": "^7.34.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
